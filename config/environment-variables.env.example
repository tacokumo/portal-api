# Portal API 環境変数設定例
# このファイルをコピーして .env ファイルを作成し、実際の値を設定してください

# サーバー設定
SERVER_PORT=8080
LOG_LEVEL=info
PORTAL_NAME=TACOKUMO Portal

# GitHub OAuth設定
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_OAUTH_REDIRECT_URL=https://portal.tacokumo.com/auth/github/callback

# GitHub App設定
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_PRIVATE_KEY_PATH=/etc/secrets/github-app-private-key.pem

# JWT設定
JWT_PRIVATE_KEY_PATH=/etc/secrets/jwt-private-key.pem
JWT_PUBLIC_KEY_PATH=/etc/secrets/jwt-public-key.pem
JWT_ACCESS_TOKEN_DURATION=1h
JWT_REFRESH_TOKEN_DURATION=8h

# Valkey (Redis互換) 設定
VALKEY_ADDRESS=localhost:6379
VALKEY_PASSWORD=your-valkey-password
VALKEY_DB=0

# CORS設定
CORS_ALLOWED_ORIGINS=https://portal.tacokumo.com,https://app.tacokumo.com

# Kubernetes設定（既存）
# これらの環境変数は既存の機能用です
# 必要に応じて設定してください